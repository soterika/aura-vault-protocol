# ==============================================================================
# Aura Vault Protocol — Frontend Public Configuration Template
# ==============================================================================
# All variables prefixed with NEXT_PUBLIC_ are inlined into client JavaScript
# bundles at build time. Copy this file to .env.local for local overrides.
# See docs/DEPLOYMENT.md#frontend-public-configuration-reference and frontend/CLAUDE.md
# ==============================================================================

# Target Stellar Network: testnet | mainnet | futurenet (default: testnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Backend REST API endpoint (default: "" in client relative requests, http://localhost:3001 in hooks)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Real-time WebSocket endpoint (default: ws://${window.location.host}/api/ws/vault)
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/ws/vault

# Stellar block explorer transaction URL override (default: https://stellar.expert/explorer/testnet/tx)
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet/tx

# Vault administrator Stellar G-address for emergency pause UI (default: undefined)
NEXT_PUBLIC_ADMIN_ADDRESS=

# Canonical web application origin for referral link generation (default: window.location.origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry DSN for error telemetry (default: undefined / disabled)
NEXT_PUBLIC_SENTRY_DSN=
